{
  "name": "js-sdk-test-apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "vp run website#dev",
    "pdf:build": "vp run geospatial-pdf-layer#build",
    "pdf:dev": "vp run geospatial-pdf-layer#dev",
    "pdf:preview": "vp run geospatial-pdf-layer#preview",
    "prepare": "vp config",
    "ready": "vp check && vp test && vp run -r build",
    "video:build": "vp run video-layer#build",
    "video:dev": "vp run video-layer#dev",
    "video:preview": "vp run video-layer#preview"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
